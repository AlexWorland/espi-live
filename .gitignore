# Python environment and caches
.venv/
__pycache__/
*.pyc

# macOS / editor / tool state
.DS_Store
.omc/

# Office lock files and temp files
~$*
~*.tmp

# Generated captures, logs and recordings (output/ at the project root, or
# beside any standalone experiment script that was run)
output/
*.avi

# Large binaries: wheels, archives, slide decks. The FLIR SDK files under
# third_party/ are the exception: they are committed through Git LFS (see
# .gitattributes) so CI can build the camera-capable binaries.
*.zip
*.whl
*.dmg
*.tar.gz
*.pptx
!third_party/**/*.zip
!third_party/**/*.whl
!third_party/**/*.dmg
!third_party/**/*.tar.gz

# PyInstaller build output (CI builds the release binaries)
build/
dist/
*.spec

# Local-only physics archive: contains third-party documents and personal files
research/
