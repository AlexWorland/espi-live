# Python environment and caches
.venv/
__pycache__/
*.pyc

# macOS / editor / tool state
.DS_Store
.omc/

# Office lock files and temp files
~$*
~*.tmp

# Generated captures, logs and recordings (output/ at the project root, or
# beside any standalone experiment script that was run)
output/
*.avi

# Large binaries: wheels, archives, slide decks
*.zip
*.whl
*.dmg
*.tar.gz
*.pptx

# FLIR Spinnaker SDK: a clone of the private espi-live-sdk repository (never
# commit it here; this repository is public)
third_party/

# PyInstaller build output (CI builds the release binaries)
build/
dist/
*.spec

# Local-only physics archive: contains third-party documents and personal files
research/

# Written by CI before PyInstaller (build number, update token); never commit
src/espi_live/_build_info.py
update-token.txt

# Coverage data
.coverage
.coverage.*
htmlcov/
