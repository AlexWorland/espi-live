# Line-coverage settings for the camera-free test suite:
#   PYTHONPATH=src python -m coverage run -m unittest discover -s tests
#   python -m coverage report
[run]
source = src/espi_live
omit =
    # Generated by CI before PyInstaller; never present in a checkout
    src/espi_live/_build_info.py

[report]
show_missing = true
skip_covered = false
fail_under = 100
