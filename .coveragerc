# Line-coverage settings for the camera-free test suite:
#   PYTHONPATH=src python -m coverage run -m unittest discover -s tests
#   python -m coverage report
[run]
source = src/espi_live
omit =
    # Generated by CI before PyInstaller; never present in a checkout
    src/espi_live/_build_info.py
    # The --headless batch run has no tests yet (added without them on purpose);
    # remove this line, and the exclude below, when tests are written.
    src/espi_live/headless.py

[report]
show_missing = true
skip_covered = false
fail_under = 100
exclude_lines =
    pragma: no cover
    # --headless dispatch in cli.py, untested like headless.py itself
    if args\.headless:
