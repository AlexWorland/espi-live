# FLIR Spinnaker SDK files are too large for plain git (GitHub rejects >100 MB).
# CI fetches only the ones it needs with `git lfs pull --include=...`.
third_party/**/*.whl filter=lfs diff=lfs merge=lfs -text
third_party/**/*.zip filter=lfs diff=lfs merge=lfs -text
third_party/**/*.dmg filter=lfs diff=lfs merge=lfs -text
third_party/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text
